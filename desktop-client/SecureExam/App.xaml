<Application x:Class="SecureExam.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#07111F"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#102035"/>
        <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#1F3A52"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F8FC"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A8BD"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#29445C"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#62C4C9"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#07111F"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E58B87"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
    </Application.Resources>
</Application>
