<Window x:Class="SecureExam.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ExamShield - Student Dashboard" Height="650" Width="950"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Content="Logout" DockPanel.Dock="Right" Background="#334155" Foreground="White" Padding="15,8" Click="Logout_Click"/>
            <Button x:Name="BtnTheme" Content="Light mode" DockPanel.Dock="Right" Background="{DynamicResource RaisedSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="15,8" Margin="0,0,10,0" Click="Theme_Click"/>
            <Button Content="Refresh exams" DockPanel.Dock="Right" Background="#0369A1" Foreground="White" Padding="15,8" Margin="0,0,10,0" Click="Refresh_Click"/>
            <StackPanel>
                <TextBlock x:Name="TxtWelcome" Text="Welcome, Student!" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Secure examination workspace" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
            <TabItem Header="Available Exams">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBackgroundBrush}">
                    <ItemsControl x:Name="LstTests">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding description}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding durationStr}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Start exam" Tag="{Binding id}" IsEnabled="{Binding canStart}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" Padding="20,10" VerticalAlignment="Center" Click="BtnStartExam_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Student Results" Loaded="ResultsTab_Loaded">
                <wv2:WebView2 x:Name="ResultsWebView" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
