<Window x:Class="SecureExam.Views.PortalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ExamShield Portal" Height="800" Width="1280" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ExamShield  |  Portal" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <StackPanel x:Name="FacultyNavigation" Orientation="Horizontal">
                    <Button Content="Question Bank" Tag="/faculty/questions" Click="Navigate_Click" Padding="14,8" Margin="3"/>
                    <Button Content="Test Builder" Tag="/faculty/tests" Click="Navigate_Click" Padding="14,8" Margin="3"/>
                    <Button Content="Live Monitoring" Tag="/faculty/tests" Click="Navigate_Click" Padding="14,8" Margin="3"/>
                </StackPanel>
                <StackPanel x:Name="AdminNavigation" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="Administration" Tag="/faculty/administration?view=dashboard" Click="Navigate_Click" Padding="14,8" Margin="3"/>
                    <Button Content="Batches &amp; Divisions" Tag="/faculty/administration?view=groups" Click="Navigate_Click" Padding="14,8" Margin="3"/>
                    <Button Content="User Management" Tag="/faculty/administration?view=users" Click="Navigate_Click" Padding="14,8" Margin="3"/>
                    <Button Content="Audit Logs" Tag="/faculty/administration?view=audit" Click="Navigate_Click" Padding="14,8" Margin="3"/>
                </StackPanel>
                <Button Content="Sign out" Click="Logout_Click" Padding="14,8" Margin="12,3,3,3"/>
                <Button x:Name="BtnTheme" Content="Light mode" Click="Theme_Click" Padding="14,8" Margin="3"/>
            </StackPanel>
        </Border>
        <wv2:WebView2 x:Name="WebView" />
    </DockPanel>
</Window>
