<Window x:Class="SecureExam.Views.ExamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ExamShield Kiosk Mode" WindowState="Maximized" WindowStyle="None" Topmost="True" Background="#0F172A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="ConnectionBanner" Grid.Row="0" Background="#EAB308" Padding="12,7" Visibility="Collapsed">
            <TextBlock x:Name="TxtConnectionNotice" Foreground="#111827" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Text="Connection lost. Your exam remains active; pending security reports will sync when connected."/>
        </Border>
        <Border x:Name="ViolationBanner" Grid.Row="1" Background="#DC2626" Padding="15,10" Visibility="Collapsed">
            <TextBlock x:Name="TxtViolationNotice" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
        </Border>

        <wv2:WebView2 x:Name="WebView" Grid.Row="2"/>
    </Grid>
</Window>
